cython_debug/

# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
*.nbc
*.nbi
*.nbi
*.nbc

# PMMA

# IGNORE temporary directory
pmma/temporary/

# IGNORE everything in cython directory EXCEPT pyx files
#pmma/core/pyx_src/*
#!pmma/core/pyx_src/*.pyx
#!pmma/core/pyx_src/*.pxd
pmma/core/pyx_src/**/*.html
pmma/core/pyx_src/**/*.cpp

# Ignore everything in pmma/build except .pyi files
pmma/build/*
!pmma/build/*.pyi

# Ignore everything in pmma/lib
pmma/lib/*

# annotations
*.html

# Ignore everything in temporary/
temporary/*

# Ignore everything under extern by default (except for shader_build_tools)
pmma/extern/*
!pmma/extern/shader_build_tools

# But don't ignore the 'include' directory itself (so we can control subdirs)
!pmma/extern/include/

# Ignore everything under 'include'
pmma/extern/include/*

# Allow header only modules
!pmma/extern/include/glad/
!pmma/extern/include/glad/**

!pmma/extern/include/STB/
!pmma/extern/include/STB/**

!pmma/extern/include/nlohmann/
!pmma/extern/include/nlohmann/**

# ignore build
build/*

# ignore vscode configuration
.vscode/*

# ignore documentation builds
documentation/docs/_build/*

# ignore build cache and build tools build content
build_tools/cmake/dependencies/**/build/*
build_tools/hashes.json
build_cache/*
development_tools/~$Namespaces.xlsx